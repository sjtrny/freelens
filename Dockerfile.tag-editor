FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml README.md freelens.py ./
RUN pip install --no-cache-dir ".[editor]"

COPY --chown=65534:65534 scripts/evaluation_dataset.py scripts/tag_editor.py ./scripts/
COPY --chown=65534:65534 templates ./templates
COPY --chown=65534:65534 dataset ./dataset

USER 65534:65534

EXPOSE 8899

CMD ["gunicorn", "--bind=0.0.0.0:8899", "--workers=1", "--access-logfile=-", "--error-logfile=-", "scripts.tag_editor:create_app()"]
